# Copy to backend/.env and fill in. NEVER commit the real .env.
ENV=development                 # development | production
DB_BACKEND=auto                 # auto | atlas | mock  (auto = Atlas if MONGODB_URI is set, else in-memory mock)
MONGODB_URI=                    # mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=EchoCare
SECRET_KEY=                     # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAILS=                   # comma separated; the first registered user is admin anyway
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=             # e.g. https://echocare.vercel.app
GOOGLE_API_KEY=                 # Google Gemini (optional; used only after the user gives AI consent)
TAVILY_API_KEY=                 # Tavily web search (optional; used only after the user gives web consent)
CHROMA_DIR=./chroma_data        # must be a persistent disk in production
# Optional SMTP for KYC OTP e-mails. Empty = dev mode (OTP returned in the API response, non-production only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
